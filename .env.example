# Copy this to .env.local and fill values
NEXT_PUBLIC_APP_NAME="Finance & Expense Tracker"

# Google service account email (from the JSON key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Google private key (the whole key, replace newlines with \n when pasting into env file)
# Example: -----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...\n-----END PRIVATE KEY-----\n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Sheet ID (from its URL)
SHEET_ID=your_google_sheet_id_here

# Optional: default currency
DEFAULT_CURRENCY=USD
